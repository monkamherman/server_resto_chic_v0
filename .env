# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# MongoDB
DATABASE_URL="mongodb+srv://cesaristos5:D5NfqTbJGXpybjqL@k2ngrouptest.8xgdo.mongodb.net/resto_0?retryWrites=true&w=majority&appName=k2ngrouptest"



# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# API Configuration
API_PREFIX=/api/v1

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000  # 15 minutes
RATE_LIMIT_MAX=100  # limit each IP to 100 requests per windowMs

# Sentry Configuration
# Obtenez votre DSN sur https://sentry.io/
SENTRY_DSN=

# Security
HELMET_ENABLED=true

# Documentation
SWAGGER_ENABLED=true

# Email (example with SendGrid)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# EMAIL_FROM=noreply@yourdomain.com

# File Uploads
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=5MB
# ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# External Services
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret

# Cache (example with Redis)
