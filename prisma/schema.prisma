// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Modèle pour les utilisateurs
model User {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  email             String?              @unique
  password          String?
  name              String?
  role              UserRole             @default(CUSTOMER)
  phone             String?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  
  // Relations
  reservations     Reservation[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  userRewards      UserReward[]
  orders           Order[]
  reviews          Review[]
  securityLogs     SecurityLog[]

  @@map("users")
}

// Rôles utilisateur
enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

// Modèle pour les tables du restaurant
model Table {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  number       Int           @unique
  capacity     Int           // Nombre de personnes maximum
  location     String        // 'terrasse', 'salle', 'bar'
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  reservations Reservation[]

  @@map("tables")
}

// Modèle pour les réservations
model Reservation {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @map("user_id") @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableId          String   @map("table_id") @db.ObjectId
  table            Table    @relation(fields: [tableId], references: [id])
  reservationDate  DateTime @map("reservation_date") // Date et heure de la réservation
  reservationEnd   DateTime @map("reservation_end")   // Date et heure de fin de la réservation (calculée)
  duration         Int      @default(120) // Durée en minutes (2h par défaut)
  partySize        Int      @map("party_size") // Nombre de personnes
  status           String   @default("pending") // pending, confirmed, cancelled, completed
  specialRequests  String?  @map("special_requests")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  notifications    Notification[]

  @@index([userId])
  @@index([tableId])
  @@index([reservationDate])
  @@map("reservations")
}

// Modèle pour les notifications
model Notification {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  userId         String      @map("user_id") @db.ObjectId
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId  String?     @map("reservation_id") @db.ObjectId
  reservation    Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  type           String      // 'reservation_confirmation', 'reminder', 'cancellation', 'promotion'
  title          String
  message        String
  isRead         Boolean     @default(false) @map("is_read")
  pushData       Json?       @map("push_data")
  scheduledFor   DateTime?   @map("scheduled_for")
  sentAt         DateTime?   @map("sent_at")
  relatedEntity  String?     @map("related_entity") // Ex: "order:123", "reservation:456"
  readAt         DateTime?   @map("read_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([reservationId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// Modèle pour les abonnements aux notifications push
model PushSubscription {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @map("user_id") @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String   @unique
  keys         Json     // { auth: string, p256dh: string }
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_subscriptions")
}

// Modèle pour les plats
model Dish {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  price          Float
  category       String
  isAvailable    Boolean   @default(true) @map("is_available")
  imageUrl       String?   @map("image_url")
  isVegetarian   Boolean   @default(false) @map("is_vegetarian")
  isVegan        Boolean   @default(false) @map("is_vegan")
  isGlutenFree   Boolean   @default(false) @map("is_gluten_free")
  averageRating  Float?    @map("average_rating")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  orderItems     OrderItem[]
  reviews       Review[]

  @@map("dishes")
}

// Modèle pour les commandes
model Order {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  userId       String      @map("user_id") @db.ObjectId
  user         User        @relation(fields: [userId], references: [id])
  items        OrderItem[]
  total        Float
  status       String      @default("pending") // pending, confirmed, preparing, ready, completed, cancelled
  specialNotes String?     @map("special_notes")
  couponId     String?     @map("coupon_id") @db.ObjectId
  coupon       Coupon?     @relation(fields: [couponId], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// Modèle pour les éléments de commande
model OrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @map("order_id") @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId    String   @map("dish_id") @db.ObjectId
  dish      Dish     @relation(fields: [dishId], references: [id])
  quantity  Int
  price     Float
  notes     String?

  @@index([orderId])
  @@index([dishId])
  @@map("order_items")
}

// Modèle pour les avis
model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @map("user_id") @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  dishId      String   @map("dish_id") @db.ObjectId
  dish        Dish     @relation(fields: [dishId], references: [id])
  rating      Int      // 1-5
  comment     String?
  isApproved  Boolean  @default(false) @map("is_approved")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([dishId])
  @@index([rating])
  @@index([isApproved])
  @@map("reviews")
}

// Modèle pour les récompenses
model Reward {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  pointsCost  Int         @map("points_cost")
  isActive    Boolean     @default(true) @map("is_active")
  imageUrl    String?     @map("image_url")
  expiryDate  DateTime?   @map("expiry_date")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  userRewards UserReward[]

  @@map("rewards")
}

// Modèle pour les récompenses des utilisateurs
model UserReward {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @map("user_id") @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId     String   @map("reward_id") @db.ObjectId
  reward       Reward   @relation(fields: [rewardId], references: [id])
  pointsSpent  Int      @map("points_spent")
  isUsed       Boolean  @default(false) @map("is_used")
  usedAt       DateTime? @map("used_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([rewardId])
  @@index([isUsed])
  @@index([expiresAt])
  @@map("user_rewards")
}

// Modèle pour les journaux de sécurité
model SecurityLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @map("user_id") @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?    // Données supplémentaires
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("security_logs")
}

// Modèle pour les coupons de réduction
model Coupon {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  code           String   @unique
  discountType   String   @map("discount_type") // 'percentage' ou 'fixed'
  discountValue  Float    @map("discount_value")
  minOrder       Float?   @default(0) @map("min_order")
  maxDiscount    Float?   @map("max_discount")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  isActive       Boolean  @default(true) @map("is_active")
  usageLimit     Int?     @map("usage_limit")
  usedCount      Int      @default(0) @map("used_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  orders         Order[]

  @@map("coupons")
}

// Vérifiez s'il y a des modèles en double à la fin du fichier
