generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  fullName            String
  nom                 String?
  prenom              String?
  sexe                String?
  phoneNumber         String               @unique
  email               String?              @unique
  password            String?
  otpCode             String?
  otpExpiresAt        DateTime?
  otpVerified         Boolean              @default(false)
  otpSentAt           DateTime?
  isActive            Boolean              @default(false)
  role                String               @default("USER")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             Profile?
  orders              Order[]
  reviews             Review[]
  reviewVotes         ReviewVote[]
  loyaltyPoints       LoyaltyPoints?
  loyaltyTransactions LoyaltyTransaction[]
  reservations        Reservation[]
  securityLogs        SecurityLog[]
  userRewards         UserReward[]
  userRoles           UserRole[]

  @@map("users")
}

model BlacklistedEmail {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String   @unique
  reason     String?
  created_at DateTime @default(now())
  created_by String?  @db.ObjectId

  @@map("blacklisted_emails")
}

model Coupon {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  code                String   @unique
  discount_amount     Float?
  discount_percentage Float?
  min_order_amount    Float?
  max_uses            Int?
  current_uses        Int      @default(0)
  start_date          DateTime
  end_date            DateTime
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  orders              Order[]

  @@map("coupons")
}

model Dish {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  price        Float
  image_url    String?
  category     String
  is_featured  Boolean     @default(false)
  is_available Boolean     @default(true)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  orderItems   OrderItem[]
  reviews      Review[]

  @@map("dishes")
}

model LoginAttempt {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  attempts     Int      @default(1)
  last_attempt DateTime @default(now())
  ip_address   String?
  user_agent   String?

  @@map("login_attempts")
}

model LoyaltyPoints {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id      String   @unique @db.ObjectId
  points       Int      @default(0)
  total_earned Int      @default(0)
  total_spent  Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [user_id], references: [id])

  @@map("loyalty_points")
}

model LoyaltyReward {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  points_required Int
  reward_type     RewardType
  reward_value    Float?
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  userRewards     UserReward[]

  @@map("loyalty_rewards")
}

enum RewardType {
  discount_percentage
  discount_amount
  free_item
}

model LoyaltyTransaction {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  user_id          String          @db.ObjectId
  points           Int
  transaction_type TransactionType
  description      String?
  order_id         String?         @db.ObjectId
  created_at       DateTime        @default(now())
  user             User            @relation(fields: [user_id], references: [id])
  order            Order?          @relation(fields: [order_id], references: [id])

  @@map("loyalty_transactions")
}

enum TransactionType {
  earned
  spent
  expired
}

model Order {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  user_id         String?              @db.ObjectId
  status          String               @default("pending")
  total_amount    Float
  coupon_code     String?
  discount_amount Float                @default(0.00)
  final_amount    Float
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  user            User?                @relation(fields: [user_id], references: [id])
  coupon          Coupon?              @relation(fields: [coupon_code], references: [code])
  orderItems      OrderItem[]
  transactions    LoyaltyTransaction[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  order_id   String   @db.ObjectId
  dish_id    String?  @db.ObjectId
  dish_name  String
  quantity   Int
  price      Float
  subtotal   Float
  created_at DateTime @default(now())
  order      Order    @relation(fields: [order_id], references: [id])
  dish       Dish?    @relation(fields: [dish_id], references: [id])

  @@map("order_items")
}

model Profile {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String   @unique @db.ObjectId
  first_name String?
  last_name  String?
  avatar_url String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])

  @@map("profiles")
}

model Promotion {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  description         String?
  discount_percentage Float
  start_date          DateTime
  end_date            DateTime
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("promotions")
}

model Reservation {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id          String?  @db.ObjectId
  name             String
  email            String
  phone            String
  date             DateTime
  time             String
  guests           Int
  special_requests String?
  status           String   @default("pending")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  user             User?    @relation(fields: [user_id], references: [id])

  @@map("reservations")
}

model Review {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  user_id        String?      @db.ObjectId
  dish_id        String?      @db.ObjectId
  rating         Int
  comment        String?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  is_approved    Boolean      @default(false)
  admin_response String?
  helpful_count  Int          @default(0)
  total_votes    Int          @default(0)
  user           User?        @relation(fields: [user_id], references: [id])
  dish           Dish?        @relation(fields: [dish_id], references: [id])
  votes          ReviewVote[]

  @@map("reviews")
}

model ReviewVote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String   @db.ObjectId
  review_id  String   @db.ObjectId
  is_helpful Boolean
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
  review     Review   @relation(fields: [review_id], references: [id])

  @@map("review_votes")
}

model SecurityLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String?  @db.ObjectId
  action     String
  details    Json?
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id])

  @@map("security_logs")
}

model UserReward {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String        @db.ObjectId
  reward_id  String        @db.ObjectId
  is_used    Boolean       @default(false)
  claimed_at DateTime      @default(now())
  used_at    DateTime?
  expires_at DateTime?
  user       User          @relation(fields: [user_id], references: [id])
  reward     LoyaltyReward @relation(fields: [reward_id], references: [id])

  @@map("user_rewards")
}

model UserRole {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String   @db.ObjectId
  role       String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@map("user_roles")
}
