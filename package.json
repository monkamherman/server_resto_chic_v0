{
  "name": "@k2ngroup/user_manager-backend",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20.12.0",
    "yarn": ">=1.22.19",
    "npm": " Herman dev: Utiliser bun pour ce projet ."
  },
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --clear --transpile-only --ignore-watch node_modules ./src/app.ts",
    "build": "rimraf ./dist && tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest test/unit",
    "test:unit:watch": "jest test/unit --watch",
    "test:integration": "jest test/integration",
    "test:integration:watch": "jest test/integration --watch",
    "prepare": "husky",
    "ac": "git add . && git-cz",
    "acp": "git add . && git-cz && git pull && git push",
    "commit": "git-cz",
    "commit:retry": "git-cz --retry",
    "generate": "ts-node --project tsconfig.plop.json plopfile.ts",
    "generate:domain": "ts-node --project tsconfig.plop.json scripts/generate-prisma-models.ts && ts-node --project tsconfig.plop.json plopfile.ts domain",
    "generate:controller": "ts-node --project tsconfig.plop.json plopfile.ts controller",
    "generate:repository": "ts-node --project tsconfig.plop.json plopfile.ts repository",
    "generate:prisma-models": "ts-node --project tsconfig.plop.json scripts/generate-prisma-models.ts",
    "generate:order": "ts-node --project tsconfig.plop.json scripts/generate-prisma-models.ts && ts-node --project tsconfig.plop.json plopfile.ts domain Order",
    "plop": "ts-node --project tsconfig.plop.json plopfile.ts"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.36.0",
    "@nestjs/cli": "10.0.0",
    "@nestjs/testing": "10.0.0",
    "@prisma/sdk": "^4.0.0",
    "@types/bun": "latest",
