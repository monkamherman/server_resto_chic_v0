{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../../src/$1"
  },
  "setupFilesAfterEnv": ["<rootDir>/test-setup.ts"],
  "globalSetup": "<rootDir>/test-setup.ts",
  "globalTeardown": "<rootDir>/test-teardown.ts",
  "testTimeout": 30000
}
